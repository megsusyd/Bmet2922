def add_plots(canvas_element):
    """Create raw and filtered PPG subplots."""

    figure = Figure(figsize=(7, 5), dpi=100)

    ax_raw = figure.add_subplot(211)
    ax_filtered = figure.add_subplot(212)

    canvas = FigureCanvasTkAgg(
        figure,
        canvas_element.TKCanvas
    )

    canvas.draw()

    canvas.get_tk_widget().pack(
        side="top",
        fill="both",
        expand=True
    )

    return ax_raw, ax_filtered, canvas


def update_ppg_plots(
    ax_raw,
    ax_filtered,
    fig_canvas,
    ppg_times,
    raw_values,
    filtered_values
):
    """Update the raw and filtered PPG graphs."""

    # -----------------------------
    # Raw PPG graph
    # -----------------------------
    ax_raw.clear()
    ax_raw.set_title("Raw PPG Signal")
    ax_raw.set_ylabel("ADC Reading")
    ax_raw.set_xlabel("Time (seconds)")
    ax_raw.grid(True, alpha=0.3)

    if ppg_times and raw_values:
        raw_times = list(ppg_times)
        raw_data = list(raw_values)

        ax_raw.plot(
            raw_times,
            raw_data,
            linewidth=1
        )

        latest_time = raw_times[-1]
        earliest_time = max(
            0,
            latest_time - GRAPH_WINDOW_SECONDS
        )

        ax_raw.set_xlim(
            earliest_time,
            max(
                earliest_time + GRAPH_WINDOW_SECONDS,
                latest_time
            )
        )

    # -----------------------------
    # Filtered PPG graph
    # -----------------------------
    ax_filtered.clear()
    ax_filtered.set_title("Filtered PPG Signal")
    ax_filtered.set_ylabel("Filtered amplitude")
    ax_filtered.set_xlabel("Time (seconds)")
    ax_filtered.grid(True, alpha=0.3)

    if len(filtered_values) > 0 and len(ppg_times) > 0:
        filtered_data = list(filtered_values)

        number_to_plot = min(
            len(filtered_data),
            len(ppg_times)
        )

        filtered_times = list(ppg_times)[-number_to_plot:]
        filtered_to_plot = filtered_data[-number_to_plot:]

        ax_filtered.plot(
            filtered_times,
            filtered_to_plot,
            linewidth=1.2
        )

        # Display the latest filtered samples across the graph.
        if len(filtered_times) > 1:
            ax_filtered.set_xlim(
                filtered_times[0],
                filtered_times[-1]
            )

    # -----------------------------
    # Refresh both graphs
    # -----------------------------
    fig_canvas.figure.tight_layout(pad=2.0)
    fig_canvas.draw()


