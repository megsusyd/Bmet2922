                        fft_bpm, freqs, fft_vals = (
                            signal_processor.calculate_fft_bpm(
                                np.asarray(filtered_values)
                            )
                        )

                # --------------------------------------------
                # UPDATE RAW AND FILTERED GRAPHS
                # --------------------------------------------
                update_ppg_plots(
                    ax_raw,
                    ax_filtered,
                    fig_canvas,
                    ppg_times,
                    ppg_values,
                    filtered_values
                )

                # --------------------------------------------
                # UPDATE PYTHON FFT ESTIMATE
                # --------------------------------------------
                if fft_bpm > 0:
                    my_window["-FFT-BPM-"].update(
                        f"{fft_bpm:.1f} BPM"
                    )

                    my_window["-FFT-STATUS-"].update(
                        "Estimate available",
                        text_color="green"
                    )

                else:
                    my_window["-FFT-BPM-"].update("--")

                    if len(processing_buffer) < 150:
                        my_window["-FFT-STATUS-"].update(
                            "Collecting samples",
                            text_color="gray"
                        )
                    else:
                        my_window["-FFT-STATUS-"].update(
                            "Signal too weak",
                            text_color="orange"
                        )

                # --------------------------------------------
                # USE ESP32 BPM AS THE MAIN READING
                # --------------------------------------------
                if esp32_bpm <= 0:
                    continue

                timestamp = datetime.now()

                my_window["-CURRENT-BPM-"].update(
                    f"{esp32_bpm:.1f} BPM"
                )

                # --------------------------------------------
                # SELECT ACTIVE ALERT SETTINGS
                # --------------------------------------------
                if exercise_mode:
                    mean_pulse = exercise_mean
                    alert_range = exercise_alert
                    mode_name = "Exercise"
                else:
                    mean_pulse = resting_mean
                    alert_range = resting_alert
                    mode_name = "Resting"

                low_threshold = mean_pulse - alert_range
                high_threshold = mean_pulse + alert_range

                if esp32_bpm < low_threshold:
                    indicator = "LOW"
                elif esp32_bpm > high_threshold:
                    indicator = "HIGH"
                else:
                    indicator = "NORMAL"

                indicator_changed = (
                    "YES"
                    if indicator != previous_indicator
                    else "NO"
                )

                alert_event = (
                    indicator
                    if indicator in ("LOW", "HIGH")
                    and indicator != previous_indicator
                    else ""
                )

                previous_indicator = indicator

                # --------------------------------------------
                # UPDATE LOW / NORMAL / HIGH INDICATORS
                # --------------------------------------------
                indicator_colours = {
                    "LOW": "#F4A6A6",
                    "NORMAL": "#A8E6A1",
                    "HIGH": "#F4A6A6"
                }

                for key, name in [
                    ("-LOW-", "LOW"),
                    ("-NORMAL-", "NORMAL"),
                    ("-HIGH-", "HIGH")
                ]:
                    if indicator == name:
                        my_window[key].update(
                            background_color=indicator_colours[name],
                            text_color="black"
                        )
                    else:
                        my_window[key].update(
                            background_color="white",
                            text_color="black"
                        )

                # --------------------------------------------
                # SAVE MAIN ESP32 BPM TO CSV
                # --------------------------------------------
                try:
                    save_reading(
                        timestamp,
                        esp32_bpm,
                        indicator,
                        indicator_changed,
                        alert_event,
                        mode_name
                    )

                    set_status(
                        my_window,
                        "-LOG-STATUS-",
                        "Log: Recording",
                        "green"
                    )

                except OSError as error:
                    set_status(
                        my_window,
                        "-LOG-STATUS-",
                        "Log: Error saving",
                        "red"
                    )

                    print(f"CSV logging error: {error}")

                # --------------------------------------------
                # UPDATE MONITORING STATUS
                # --------------------------------------------
                set_status(
                    my_window,
                    "-MONITORING-",
                    "Monitoring: Active",
                    "green"
                )

                # --------------------------------------------
                # ADD TIMESTAMPED LOG ENTRY
                # --------------------------------------------
                log_line = (
                    f"{timestamp:%d/%m/%Y %H:%M:%S}; "
                    f"ESP32: {esp32_bpm:.1f} BPM; "
                    f"Python FFT: {fft_bpm:.1f} BPM; "
                    f"{indicator}; {mode_name}; "
                    f"Packet {sequence_number}"
                )

                if alert_event:
                    log_line += f"; {alert_event} alert"

                log_entries.append(log_line)

                my_window["-LOG-"].update(
                    "\n".join(
                        log_entries[-max_log_entries:]
                    )
                )

        # ----------------------------------------------------
        # DETECT STALE DATA
        # ----------------------------------------------------
        if (
            last_packet_time is not None
            and time.monotonic() - last_packet_time > 3
        ):
            set_status(
                my_window,
                "-MONITORING-",
                "Monitoring: Waiting for data",
                "orange"
            )

            set_status(
                my_window,
                "-LOG-STATUS-",
                "Log: Paused",
                "orange"
            )

            last_packet_time = None

finally:
    # Stop the receiver and allow it to close its serial port.
    stop_receiver.set()

    if receiver_thread.is_alive():
        receiver_thread.join(timeout=1)

    my_window.close()
