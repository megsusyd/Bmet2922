# ============================================================
# 2. PPG SIGNAL PROCESSING
# ============================================================

class PPGSignalProcessor:
    """
    Filter PPG samples and estimate BPM using an FFT.

    The ESP32-calculated BPM remains the primary BPM reading.
    This class calculates a separate Python estimate.
    """

    def __init__(self, fs: float = 50.0):
        self.fs = fs
        nyq = 0.5 * fs

        # Second-order Butterworth bandpass filter:
        # 0.5-4.0 Hz, approximately 30-240 BPM.
        self.b, self.a = butter(
            2,
            [0.5 / nyq, 4.0 / nyq],
            btype="band"
        )

    def filter_signal(self, raw_data: np.ndarray) -> np.ndarray:
        """Apply the Butterworth bandpass filter."""

        raw_data = np.asarray(raw_data, dtype=float)

        if len(raw_data) < 15:
            return raw_data

        return filtfilt(self.b, self.a, raw_data)

    def calculate_fft_bpm(self, signal_window: np.ndarray):
        """Estimate BPM from the dominant FFT frequency."""

        signal_window = np.asarray(signal_window, dtype=float)
        N = len(signal_window)

        if N == 0:
            return 0.0, np.array([]), np.array([])

        windowed = signal_window * np.hanning(N)
        n_fft = 2048

        fft_vals = np.abs(
            np.fft.rfft(windowed, n=n_fft)
        )

        freqs = np.fft.rfftfreq(
            n_fft,
            d=1.0 / self.fs
        )

        # Restrict estimate to 42-210 BPM.
        valid_idx = np.where(
            (freqs >= 0.7) & (freqs <= 3.5)
        )[0]

        if len(valid_idx) == 0:
            return 0.0, freqs, fft_vals

        # Avoid reporting BPM from a nearly flat signal.
        if np.std(signal_window) < 5:
            return 0.0, freqs, fft_vals

        peak_idx = valid_idx[
            np.argmax(fft_vals[valid_idx])
        ]

        dominant_freq = freqs[peak_idx]

        estimated_bpm = round(
            float(dominant_freq * 60.0),
            1
        )

        return estimated_bpm, freqs, fft_vals


