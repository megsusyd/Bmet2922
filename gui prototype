def save_reading(
    timestamp,
    bpm,
    indicator,
    indicator_changed,
    alert_event,
    mode
):
    """Save the ESP32 BPM reading and indicator to CSV."""

    os.makedirs(os.path.dirname(DATA_FILE), exist_ok=True)

    file_exists = (
        os.path.exists(DATA_FILE)
        and os.path.getsize(DATA_FILE) > 0
    )

    with open(DATA_FILE, "a", newline="") as file:
        writer = csv.DictWriter(
            file,
            fieldnames=CSV_FIELDS
        )

        if not file_exists:
            writer.writeheader()

        writer.writerow({
            "timestamp": timestamp.strftime(
                "%d/%m/%Y %H:%M:%S"
            ),
            "date": timestamp.strftime("%Y-%m-%d"),
            "bpm": round(bpm, 1),
            "indicator": indicator,
            "indicator_changed": indicator_changed,
            "alert_event": alert_event,
            "mode": mode
        })


def load_day_records(selected_date):
    """Return saved records for one date."""

    records = []

    if not os.path.exists(DATA_FILE):
        return records

    try:
        with open(DATA_FILE, "r", newline="") as file:
            reader = csv.DictReader(file)

            for row in reader:
                if row.get("date") == selected_date:
                    records.append(row)

    except OSError as error:
        print(f"Could not read CSV file: {error}")

    records.sort(key=lambda row: row.get("timestamp", ""))

    return records


def load_latest_indicator():
    """Get the last saved indicator."""

    if not os.path.exists(DATA_FILE):
        return None

    try:
        with open(DATA_FILE, "r", newline="") as file:
            rows = list(csv.DictReader(file))

        if rows:
            return rows[-1].get("indicator")

    except OSError as error:
        print(f"Could not read previous indicator: {error}")

    return None


# ============================================================
# 4. DAILY SUMMARY
# ============================================================

def show_daily_summary(selected_date):
    """Calculate and display the daily BPM summary."""

    records = load_day_records(selected_date)

    if not records:
        sg.popup(
            f"No readings were found for {selected_date}.",
            title="Daily Summary"
        )
        return

    bpm_values = []

    for row in records:
        try:
            bpm = float(row["bpm"])

            if math.isfinite(bpm) and 0 < bpm <= 250:
                bpm_values.append(bpm)

        except (ValueError, KeyError, TypeError):
            continue

    if not bpm_values:
        sg.popup(
            "No valid BPM readings were found.",
            title="Daily Summary"
        )
        return

    mean_bpm = statistics.mean(bpm_values)
    min_bpm = min(bpm_values)
    max_bpm = max(bpm_values)

    std_bpm = (
        statistics.pstdev(bpm_values)
        if len(bpm_values) > 1 else 0.0
    )

    low_alerts = sum(
        row.get("alert_event") == "LOW"
        for row in records
    )

    high_alerts = sum(
        row.get("alert_event") == "HIGH"
        for row in records
    )

    indicator_changes = [
        f'{row["timestamp"]}: {row["indicator"]}'
        for row in records
        if row.get("indicator_changed") == "YES"
    ]

    change_text = (
        "\n".join(indicator_changes)
        if indicator_changes
        else "No indicator changes recorded."
    )

    summary = (
        f"Date: {selected_date}\n\n"
        f"Valid BPM readings: {len(bpm_values)}\n"
        f"Mean BPM: {mean_bpm:.1f}\n"
        f"Minimum BPM: {min_bpm:.1f}\n"
        f"Maximum BPM: {max_bpm:.1f}\n"
        f"Population standard deviation: {std_bpm:.1f}\n\n"
        f"LOW alert events: {low_alerts}\n"
        f"HIGH alert events: {high_alerts}\n\n"
        f"Indicator changes:\n{change_text}"
    )

    sg.popup_scrolled(
        summary,
        title="Daily Summary",
        size=(65, 25),
        font=("Arial", 11)
    )


