# 7. BLUETOOTH PACKET DECODING
# ============================================================

def decode_packet(packet):
    """Decode one complete ESP32 packet."""

    if len(packet) != PACKET_SIZE:
        return None

    try:
        unpacked = struct.unpack(
            PACKET_FORMAT,
            packet
        )

        sequence_number = unpacked[0]
        heart_rate = unpacked[1]
        raw_samples = list(unpacked[2:])

        if not math.isfinite(heart_rate):
            return None

        if not 0 <= heart_rate <= 250:
            return None

        if any(sample > 4095 for sample in raw_samples):
            return None

        return sequence_number, heart_rate, raw_samples

    except (struct.error, ValueError):
        return None


# ============================================================
# 8. BLUETOOTH RECEIVER WITH AUTO-RECONNECTION
# ============================================================

def bluetooth_receiver():
    """
    Receive ESP32 binary packets in a background thread.

    On a serial connection error:
    1. Report disconnection.
    2. Close the old connection.
    3. Wait two seconds.
    4. Attempt to reconnect automatically.

    Packet resynchronisation is best-effort because the current
    ESP32 packet format has no unique marker or checksum.
    """

    while not stop_receiver.is_set():
        connection = None

        try:
            # --------------------------------------------
            # ATTEMPT TO CONNECT
            # --------------------------------------------
            bluetooth_queue.put(("status", "connecting"))

            connection = serial.Serial(
                port=PORT,
                baudrate=BAUDRATE,
                bytesize=serial.EIGHTBITS,
                timeout=0.2,
                stopbits=serial.STOPBITS_ONE
            )

            print(f"Bluetooth connected: {PORT}")

            bluetooth_queue.put(("status", "connected"))

            # Start with a fresh buffer for this connection.
            buffer = bytearray()

            # --------------------------------------------
            # RECEIVE AND DECODE PACKETS
            # --------------------------------------------
            while not stop_receiver.is_set():

                chunk = connection.read(512)

                if not chunk:
                    # A read timeout does not necessarily mean
                    # Bluetooth has disconnected.
                    continue

                buffer.extend(chunk)

                while len(buffer) >= PACKET_SIZE:

                    candidate = bytes(buffer[:PACKET_SIZE])
                    decoded = decode_packet(candidate)

                    if decoded is not None:
                        del buffer[:PACKET_SIZE]

                        bluetooth_queue.put(
                            ("packet", decoded)
                        )

                        continue

                    # ------------------------------------
                    # BEST-EFFORT PACKET RESYNCHRONISATION
                    # ------------------------------------
                    found = False
                    max_offset = len(buffer) - PACKET_SIZE

                    for offset in range(1, max_offset + 1):

                        candidate = bytes(
                            buffer[offset:offset + PACKET_SIZE]
                        )

                        decoded = decode_packet(candidate)

                        if decoded is not None:
                            del buffer[:offset + PACKET_SIZE]

                            bluetooth_queue.put(
                                ("packet", decoded)
                            )

                            found = True
                            break

                    if not found:
                        # Keep enough bytes to complete a packet
                        # when the next serial chunk arrives.
                        del buffer[:-PACKET_SIZE + 1]
                        break

        except (serial.SerialException, OSError) as error:

            if not stop_receiver.is_set():
                print(f"Bluetooth connection lost: {error}")

                bluetooth_queue.put(
                    ("status", "disconnected")
                )

        finally:
            # --------------------------------------------
            # CLOSE THE OLD CONNECTION
            # --------------------------------------------
            if connection is not None:
                try:
                    if connection.is_open:
                        connection.close()

                except (serial.SerialException, OSError) as error:
                    print(f"Error closing serial port: {error}")

        # --------------------------------------------
        # WAIT BEFORE RETRYING
        # --------------------------------------------
        if not stop_receiver.is_set():
            bluetooth_queue.put(("status", "connecting"))

            print(
                f"Retrying Bluetooth connection in "
                f"{RECONNECT_DELAY:.0f} seconds..."
            )

            stop_receiver.wait(RECONNECT_DELAY)

    print("Bluetooth receiver stopped.")


