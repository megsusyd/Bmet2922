                    ppg_elapsed += SAMPLE_INTERVAL

                    ppg_times.append(ppg_elapsed)
                    ppg_values.append(sample)

                    processing_buffer.append(sample)

                # --------------------------------------------
                # FILTER THE ROLLING PPG BUFFER
                # --------------------------------------------
                filtered_values = []
                fft_bpm = 0.0

                if len(processing_buffer) >= 150:
                    raw_window = np.asarray(
                        processing_buffer,
                        dtype=float
                    )

